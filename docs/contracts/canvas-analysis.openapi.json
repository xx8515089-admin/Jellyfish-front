  "components": {
    "schemas": {
      "CanvasAnalysisEstimateBody": {
        "type": "object",
        "properties": {
          "canvasId": {
            "oneOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ]
          },
          "revisionNo": {
            "type": "integer"
          },
          "nodeId": {
            "type": "string"
          },
          "sourceNodeId": {
            "type": "string"
          },
          "operation": {
            "type": "string",
