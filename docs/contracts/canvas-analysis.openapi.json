              "videoAnalyze",
              "transcribeAudio"
            ]
          },
          "modelId": {
            "type": "integer"
          },
          "selection": {
            "type": "object",
            "properties": {
              "frames": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "frameId": {
                      "type": "string"
                    },
                    "assetId": {
                      "oneOf": [
                        {
                          "type": "integer"
                        },
                        {
                          "type": "string"
                        }
                      ]
                    },
                    "timeSeconds": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "frameId",
                    "assetId",
                    "timeSeconds"
                  ]
                }
              },
              "videoAssetId": {
                "oneOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "audioAssetId": {
                "oneOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  }
                ]
              }
            },
            "required": []
          },
          "parameters": {
            "type": "object",
            "properties": {
              "segmentDurationSeconds": {
                "type": "number"
              },
              "startSeconds": {
                "type": "number"
              },
              "endSeconds": {
                "type": "number"
              },
              "promptLanguages": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": []
          }
        },
        "required": [
          "canvasId",
          "revisionNo",
          "nodeId",
          "sourceNodeId",
          "operation",
          "modelId",
          "selection"
        ]
      },
      "CanvasAnalysisCreateBody": {
        "type": "object",
        "properties": {
          "canvasId": {
            "oneOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ]
          },
          "quoteId": {
            "type": "string"
          },
          "clientRequestId": {
            "type": "string"
          },
          "maxReservedCredits": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "canvasId",
          "quoteId",
          "clientRequestId"
        ]
      },
      "CanvasAnalysisRetryBody": {
        "type": "object",
        "properties": {
          "canvasId": {
            "oneOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ]
          },
          "quoteId": {
            "type": "string"
          },
          "clientRequestId": {
            "type": "string"
          },
          "maxReservedCredits": {
            "type": "number",
            "minimum": 0
          },
          "taskId": {
            "oneOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ]
          }
        },
        "required": [
          "canvasId",
          "taskId",
          "quoteId",
          "clientRequestId"
        ]
      },
      "CanvasAnalysisTaskBody": {
        "type": "object",
        "properties": {
          "canvasId": {
            "oneOf": [
              {
                "type": "integer"
              },
              {
