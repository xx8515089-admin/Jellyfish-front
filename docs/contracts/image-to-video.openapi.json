      "get": {
        "tags": [
          "ImageToVideo"
        ],
        "operationId": "getModels",
        "responses": {
          "200": {
            "description": "Business envelope; code must equal 200",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ImageToVideoModel"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/studio/storyboards/imagetovideo/estimate": {
      "get": {
        "tags": [
          "ImageToVideo"
        ],
        "operationId": "getEstimate",
        "parameters": [
