          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Business envelope; code must equal 200",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
