  "components": {
    "schemas": {
      "ImageToVideoModel": {
        "type": "object",
        "required": [
          "id",
          "name",
          "modelCode",
          "resolutions",
          "durationSeconds",
          "maxPromptCharacters"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "modelCode": {
            "type": "string"
          },
          "defaultModel": {
            "type": "boolean"
          },
          "resolutions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "durationSeconds": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "maxPromptCharacters": {
            "type": "integer"
          },
          "minImageWidth": {
            "type": "integer"
          },
          "minImageHeight": {
            "type": "integer"
          },
          "maxImageBytes": {
            "type": "integer"
          }
        }
      },
      "ImageToVideoDetail": {
        "type": "object",
        "required": [
          "id",
          "segmentId",
          "status"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "segmentId": {
            "type": "integer"
          },
          "generationRecordId": {
            "type": "integer"
          },
          "taskId": {
            "type": "integer"
          },
          "status": {
            "type": "integer"
          },
          "statusName": {
            "type": "string"
          },
          "progress": {
            "type": "integer"
          },
          "outputUrl": {
            "type": "string"
          },
          "outputFileId": {
            "type": "integer"
          },
          "error": {
            "type": "string"
          },
          "providerTaskId": {
            "type": "string"
          },
          "generationMode": {
            "type": "string"
          }
        }
      },
      "ImageToVideoEstimate": {
        "type": "object",
        "required": [
          "modelId",
          "creditCost"
        ],
        "properties": {
          "modelId": {
            "type": "integer"
          },
          "creditCost": {
            "type": "number"
          },
          "priceValidUntil": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "ImageToVideoGenerate": {
        "type": "object",
        "required": [
          "imageGenerationId",
          "prompt"
        ],
        "additionalProperties": false,
        "properties": {
          "imageGenerationId": {
            "type": "integer"
          },
          "modelId": {
            "type": "integer"
          },
          "resolution": {
            "type": "string"
          },
          "durationSeconds": {
            "type": "integer"
          },
          "prompt": {
            "type": "string"
          },
          "visualStyleId": {
            "type": "integer",
            "nullable": true
          },
          "toneStyleId": {
            "type": "integer",
            "nullable": true
          },
          "scope": {
            "type": "string",
            "enum": [
              "whole_image",
              "single_panel",
              "all_panels"
            ]
          },
          "panelId": {
            "type": "string"
          },
          "panelRevision": {
            "type": "integer"
          }
        }
      },
      "StoryboardPanel": {
        "type": "object",
        "required": [
          "panelId",
          "panelIndex"
        ],
        "properties": {
          "panelId": {
            "type": "string"
          },
          "panelIndex": {
            "type": "integer"
          },
          "sourceShotNumber": {
            "type": "integer",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "bounds": {
            "type": "object",
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width": {
                "type": "number"
              },
              "height": {
                "type": "number"
              }
            },
            "nullable": true
          }
        }
      },
      "StoryboardPanelImage": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "status": {
            "type": "integer"
          },
          "outputUrl": {
            "type": "string",
            "nullable": true
          },
          "panelStatus": {
            "type": "string"
          },
          "panelRevision": {
            "type": "integer",
            "nullable": true
          },
          "panels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StoryboardPanel"
            }
          }
        }
      },
      "PanelVideoPromptRequest": {
        "type": "object",
        "required": [
          "imageGenerationId",
          "scope"
        ],
        "properties": {
          "imageGenerationId": {
            "type": "integer"
          },
          "scope": {
            "type": "string",
            "enum": [
              "whole_image",
              "single_panel",
              "all_panels"
            ]
          },
          "panelId": {
            "type": "string"
          },
          "panelRevision": {
            "type": "integer"
          },
          "modelId": {
            "type": "integer"
          },
          "resolution": {
            "type": "string"
          },
          "durationSeconds": {
            "type": "integer"
          }
        }
      },
      "PanelVideoPrompt": {
        "type": "object",
        "required": [
          "imageGenerationId",
          "scope",
          "modelId",
          "resolution",
          "durationSeconds",
          "prompt"
        ],
        "properties": {
          "imageGenerationId": {
            "type": "integer"
          },
          "scope": {
            "type": "string",
            "enum": [
              "whole_image",
              "single_panel",
              "all_panels"
            ]
          },
          "panelId": {
            "type": "string",
            "nullable": true
          },
          "panelRevision": {
            "type": "integer",
            "nullable": true
          },
          "modelId": {
            "type": "integer"
          },
          "resolution": {
            "type": "string"
          },
          "durationSeconds": {
            "type": "integer"
          },
          "prompt": {
            "type": "string"
          },
          "generationMethod": {
            "type": "string"
          },
          "panels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StoryboardPanel"
            }
          },
          "firstFramePanel": {
            "allOf": [
              {
                "$ref": "#/components/schemas/StoryboardPanel"
              }
            ],
            "nullable": true
          }
        }
      }
    }
  }
}
