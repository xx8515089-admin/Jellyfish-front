{
  "name": "jellyfish-frontend",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test:storyboard-video-batch": "node scripts/test-storyboard-video-batch.mjs",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "audit:director-actions": "node ./scripts/audit-director-character-actions.mjs",
    "preview": "vite preview",
    "openapi:fetch": "node ./scripts/fetch-openapi.mjs",
    "openapi:gen": "pnpm exec -- openapi --input ./openapi.json --output ./src/services/generated --client fetch --useOptions --useUnionTypes && node ./scripts/patch-workflow-client.mjs",
    "openapi:update": "node ./scripts/update-openapi.mjs",
    "openapi:efficiency": "node ./scripts/generate-efficiency-client.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^5.2.6",
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.17.14",
    "antd": "^5.10.0",
    "camera-controls": "2.9.0",
    "dayjs": "^1.11.21",
    "dompurify": "^3.0.8",
    "echarts": "^6.1.0",
    "file-saver": "^2.0.5",
    "i18next": "^23.11.4",
    "i18next-browser-languagedetector": "^7.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.469.0",
    "marked": "^12.0.0",
    "ogl": "^1.0.11",
    "react": "^18.2.0",
    "react-beautiful-dnd": "^13.1.1",
    "react-dom": "^18.2.0",
    "react-i18next": "^15.0.1",
    "react-router-dom": "^6.30.3",
    "three": "0.184.0",
    "three-stdlib": "2.36.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/react": "^18.2.37",
    "@types/react-beautiful-dnd": "^13.1.8",
    "@types/react-dom": "^18.2.15",
    "@types/three": "0.184.1",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.54.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "openapi-typescript-codegen": "^0.30.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.2.2",
    "vite": "^5.0.8"
  }
}
